        <sensor name="fs_neck_yaw_assembly" link="neck_yaw_assembly" offset="0 0 0" flags="contact "/>
        <sensor name="fs_head_pitch_to_yaw" link="head_pitch_to_yaw" offset="0 0 0" flags="contact "/>
        <sensor name="fs_neck_pitch_assembly" link="neck_pitch_assembly" offset="0 0 0" flags="contact "/>
        <sensor name="fs_base" link="base" offset="0 -0 0" flags="contact "/>
    </forceSensor>
    <jointForceSensor value="true"/>
    <filter>
        <pair link0="base" link1="neck_pitch_assembly"/>
        <pair link0="base" link1="hip_roll_assembly_2"/>
        <pair link0="base" link1="right_roll_to_pitch_assembly"/>
        <pair link0="base" link1="hip_roll_assembly"/>
        <pair link0="base" link1="left_roll_to_pitch_assembly"/>
        <pair link0="neck_pitch_assembly" link1="base"/>
        <pair link0="hip_roll_assembly_2" link1="base"/>
        <pair link0="hip_roll_assembly_2" link1="right_roll_to_pitch_assembly"/>
        <pair link0="right_roll_to_pitch_assembly" link1="base"/>
        <pair link0="right_roll_to_pitch_assembly" link1="hip_roll_assembly_2"/>
        <pair link0="right_roll_to_pitch_assembly" link1="knee_and_ankle_assembly_3"/>
        <pair link0="knee_and_ankle_assembly_3" link1="right_roll_to_pitch_assembly"/>
        <pair link0="knee_and_ankle_assembly_3" link1="knee_and_ankle_assembly_4"/>
        <pair link0="knee_and_ankle_assembly_4" link1="knee_and_ankle_assembly_3"/>
        <pair link0="hip_roll_assembly" link1="base"/>
        <pair link0="hip_roll_assembly" link1="left_roll_to_pitch_assembly"/>
        <pair link0="left_roll_to_pitch_assembly" link1="base"/>
        <pair link0="left_roll_to_pitch_assembly" link1="hip_roll_assembly"/>
        <pair link0="left_roll_to_pitch_assembly" link1="knee_and_ankle_assembly"/>
        <pair link0="knee_and_ankle_assembly" link1="left_roll_to_pitch_assembly"/>
        <pair link0="knee_and_ankle_assembly" link1="knee_and_ankle_assembly_2"/>
        <pair link0="knee_and_ankle_assembly_2" link1="knee_and_ankle_assembly"/>
        <pair link0="head_pitch_to_yaw" link1="neck_yaw_assembly"/>
        <pair link0="head_pitch_to_yaw" link1="head_assembly"/>
        <pair link0="neck_yaw_assembly" link1="head_pitch_to_yaw"/>
        <pair link0="neck_yaw_assembly" link1="head_assembly"/>
        <pair link0="head_assembly" link1="head_pitch_to_yaw"/>
        <pair link0="head_assembly" link1="neck_yaw_assembly"/>
    </filter>
</robot>
