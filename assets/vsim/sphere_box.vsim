<?xml version="1.0"?>
<robot name="sphere_box">

    <link name="box">
    <visual>
      <geometry>
        <sphere radius="3"/>
      </geometry>
    </visual>
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="1"/>
      </geometry>
    </collision>
    <collision>
      <geometry>
        <box size="0.7 0.7 0.7"/>
      </geometry>
    </collision>
  </link>

</robot>
