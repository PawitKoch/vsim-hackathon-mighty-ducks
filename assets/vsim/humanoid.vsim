        <sensor name="left_foot_sensor" link="left_foot" offset="0.035 0.01 -0.03" flags="contact"/>
        <sensor name="right_foot_sensor" link="right_foot" offset="0.035 -0.01 -0.03" flags="contact"/>
    </forceSensor>
    <jointForceSensor value="true"/>
    <filter>
        <pair link0="torso" link1="left_upper_arm"/>
        <pair link0="torso" link1="right_upper_arm"/>
        <pair link0="torso" link1="lwaist"/>
        <pair link0="pelvis" link1="left_thigh"/>
        <pair link0="left_shin" link1="left_foot"/>
        <pair link0="pelvis" link1="right_thigh"/>
        <pair link0="right_shin" link1="right_foot"/>
    </filter>
</robot>
