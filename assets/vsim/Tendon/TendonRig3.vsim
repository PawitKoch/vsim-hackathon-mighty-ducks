            <mass value="-1"/>
            <density value="800"/>
            <inertia ixx="-1" iyy="-1" izz="-1" ixy="-1" ixz="-1" iyz="-1"/>
        </inertial>
        <visual>
            <origin xyz="0 -0 0" rot="-0 0 -0 1"/>
            <geometry>
                <box size="0.25 0.5 0.25"/>
