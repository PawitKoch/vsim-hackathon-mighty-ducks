<robot name="VlabSphereActor">
    <!--Materials-->
    <rigidMaterial name="DefaultRigidMaterial" staticFriction="0.5" dynamicFriction="0.5" restitution="0.1"/>
    <!--Links-->
    <robotProperties maxDepenetrationVelocity="10"/>
    <link name="VlabRigidBody">
        <inertial>
            <origin xyz="0 0 0" rot="0 0 0 1"/>
            <mass value="-1"/>
            <density value="800"/>
            <inertia ixx="-1" iyy="-1" izz="-1" ixy="-1" ixz="-1" iyz="-1"/>
        </inertial>
        <visual>
            <origin xyz="0 -0 0" rot="-0 0 -0 1"/>
            <geometry>
                <sphere radius="0.5"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 -0 0" rot="-0 0 -0 1"/>
            <geometry>
                <sphere radius="0.5"/>
                <queryProperties useQueries="true" layer="268435454" mask="4294967295"/>
            </geometry>
        </collision>
        <rigidMaterialRef name="DefaultRigidMaterial"/>
        <miscellaneous contactOffset="0.005" restOffset="0"/>
    </link>
</robot>
