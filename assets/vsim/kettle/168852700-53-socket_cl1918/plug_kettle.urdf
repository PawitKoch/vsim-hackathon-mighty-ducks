<?xml version="1.0"?>
<robot name="kettle_plug">
    <link name="kettle_link">
        <inertial>
            <origin xyz="-0.001 0 -0.001" rpy="0 0 1.57"/>
            <mass value="0.002"/>
            <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
        </inertial>

        <visual>
            <origin xyz="-0.001 0 -0.001" rpy="0 0 1.57"/>
            <geometry>
                <!-- Scaling at 0.001 to convert from mm to m -->
                <mesh filename="socket_cl1918.obj" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="-0.001 0 -0.001" rpy="0 0 1.57"/>
            <geometry>
                <!-- Scaling at 0.001 to convert from mm to m -->
                <mesh filename="socket_cl1918.obj" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>
</robot>