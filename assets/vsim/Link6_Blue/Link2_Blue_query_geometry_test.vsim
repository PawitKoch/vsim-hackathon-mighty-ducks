<robot name="Link6_Blue">
    <!--Materials-->
    <material name="BlueRgbMat">
        <texture filename="package://Vlab/Textures/pattern.jpg"/>
        <color rgba="0 0.1016 1 1"/>
        <luminescence value="0"/>
        <specular value="144.4"/>
    </material>
    <!--Links-->
    <robotProperties maxDepenetrationVelocity="10"/>
    <link name="Link6_Blue">
        <inertial>
            <origin xyz="0 0 0" rot="0 0 0 1"/>
            <mass value="-1"/>
            <density value="1"/>
            <inertia ixx="-1" iyy="-1" izz="-1" ixy="-1" ixz="-1" iyz="-1"/>
        </inertial>
        <visual>
            <origin xyz="0 -0 0" rot="-0 0 -0 1"/>
            <geometry>
                <mesh filename="package://FrankaBox/franka_panda/meshes/visual/link2.FBX" scale="0.05 0.05 0.05"/>
                <settings planeNormalTolerance="0.95" inflation="0" minThickness="0.0001" maxVerts="32" mapResolution="0"/>
                <queryProperties useQueries="true"/>
            </geometry>
			<rgbMaterialRef name="BlueRgbMat"/>
        </visual>
        <collision>
            <origin xyz="0 -0 0" rot="-0 0 -0 1"/>
            <geometry>
                <mesh filename="package://FrankaBox/franka_panda/meshes/visual/link2.FBX" scale="0.05 0.05 0.05"/>
                <queryProperties useQueries="false" layer="268435454" mask="4294967295"/>
            </geometry>
        </collision>
        <miscellaneous contactOffset="0.005" restOffset="0"/>
    </link>
</robot>
