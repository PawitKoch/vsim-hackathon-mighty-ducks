<robot name="left_eef_target" version="0">
    <!--Materials-->
    <!--Links-->
    <robotProperties maxDepenetrationVelocity="10"/>
    <link name="left_eef_target">
        <inertial>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <mass value="-1"/>
            <density value="-1"/>
            <inertia ixx="-1" iyy="-1" izz="-1" ixy="-1" ixz="-1" iyz="-1"/>
        </inertial>
        <visual name="left_eef_target_box">
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <box size="0.1 0.1 0.1"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </visual>
        <visual name="left_eef_target_sphere">
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <sphere radius="0.01"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </visual>
    </link>
</robot>
