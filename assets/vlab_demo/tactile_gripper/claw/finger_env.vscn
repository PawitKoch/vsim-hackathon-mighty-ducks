        <actor name="ModelRoot 2" xyz="0 0.00541101396084 0" rot="-0.707106769085 0 0 0.707106769085" file="package://claw/small_box.vsim"/>
        <rgbCamera name="RGBCamera_def" type="pinhole" postFilter="anti_aliasing ambient_occlusion" farClip="100" fovX="1.3089969158172607" fovY="1.3089969158172607" resX="1080" resY="1080"/>
        <cameraInstance name="RGBCamera" camera="RGBCamera_def" xyz="0.197727784514 0.0329374670982 -0.00236573815346" rpy="-3.14159265359 1.56662505021 -3.14159265359">
