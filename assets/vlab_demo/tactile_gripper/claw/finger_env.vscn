        <plane name="GroundPlane" xyz="0 -0.0187397263944 0" rot="0 0 0.707106769085 0.707106769085" file="" scale="1 1 1">
            <rigidMaterial name="" staticFriction="0.5" dynamicFriction="0.5" restitution="0.10000000149"/>
            <material name="">
                <texture filename="package://claw/vsim_tile.png"/>
