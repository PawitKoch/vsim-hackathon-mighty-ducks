<robot name="car" version="0">
    <!--Materials-->
    <material name="black">
        <color rgba="0 0 0 1"/>
        <luminescence value="0"/>
        <specularExponent value="40"/>
        <specularIntensity value="0.25"/>
    </material>
    <material name="blue">
        <color rgba="0.6 0.7 0.8 1"/>
        <luminescence value="0"/>
        <specularExponent value="40"/>
        <specularIntensity value="0.25"/>
    </material>
    <!--Links-->
    <robotProperties maxDepenetrationVelocity="10"/>
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0.10000000149" rpy="0 -0 0"/>
            <mass value="6.02"/>
            <density value="-1"/>
            <inertia ixx="0.0652166708529" iyy="0.145483333931" izz="0.170566670255" ixy="0" ixz="0" iyz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <box size="0.07 0.03 0.015"/>
                <queryProperties useQueries="false"/>
            </geometry>
            <rgbMaterialRef name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <geometry>
                <box size="0.07 0.03 0.015"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </collision>
    </link>
    <link name="left_front_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <mass value="0.03"/>
            <density value="-1"/>
            <inertia ixx="0.00120000012774" iyy="0.00120000012774" izz="0.00120000012775" ixy="-3.70513716284e-11" ixz="3.70496556754e-11" iyz="3.70496556753e-11"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57075000001 1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
            <rgbMaterialRef name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57075000001 1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </collision>
    </link>
    <link name="left_back_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <mass value="0.03"/>
            <density value="-1"/>
            <inertia ixx="0.00120000012774" iyy="0.00120000012774" izz="0.00120000012775" ixy="-3.70513716284e-11" ixz="3.70496556754e-11" iyz="3.70496556753e-11"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.57075000001 1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
            <rgbMaterialRef name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57075000001 1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </collision>
    </link>
    <link name="right_front_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <mass value="0.03"/>
            <density value="-1"/>
            <inertia ixx="0.00120000012774" iyy="0.00120000012774" izz="0.00120000012775" ixy="-3.70513716284e-11" ixz="-3.70496556754e-11" iyz="-3.70496556753e-11"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="-1.57075000001 -1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
            <rgbMaterialRef name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="-1.57075000001 -1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </collision>
    </link>
    <link name="right_back_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 -0 0"/>
            <mass value="0.03"/>
            <density value="-1"/>
            <inertia ixx="0.00120000012774" iyy="0.00120000012774" izz="0.00120000012775" ixy="-3.70513716284e-11" ixz="-3.70496556754e-11" iyz="-3.70496556753e-11"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="-1.57075000001 -1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
            <rgbMaterialRef name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="-1.57075000001 -1.57075 0"/>
            <geometry>
                <sphere radius="0.007"/>
                <queryProperties useQueries="false"/>
            </geometry>
        </collision>
    </link>
    <joint name="left_hinge_to_left_front_wheel" type="continuous">
        <child link="left_front_wheel"/>
        <parent link="base_link"/>
        <origin xyz="0.03 0.01 -0.002" rpy="0 -0 0"/>
        <linkTransform xyz="0.03 0.01 -0.002" rpy="0 -0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="1" upper="-1" effort="0" velocity="30"/>
        <dynamics damping="1" stiffness="0" integral="0" friction="0" frictionLoss="0" armature="0"/>
    </joint>
    <joint name="base_to_left_back_wheel" type="continuous">
        <child link="left_back_wheel"/>
        <parent link="base_link"/>
        <origin xyz="-0.03 0.01 -0.002" rpy="0 -0 0"/>
        <linkTransform xyz="-0.03 0.01 -0.002" rpy="0 -0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="1" upper="-1" effort="0" velocity="30"/>
        <dynamics damping="1" stiffness="0" integral="0" friction="0" frictionLoss="0" armature="0"/>
    </joint>
    <joint name="right_hinge_to_right_front_wheel" type="continuous">
        <child link="right_front_wheel"/>
        <parent link="base_link"/>
        <origin xyz="0.03 -0.01 -0.002" rpy="0 -0 0"/>
        <linkTransform xyz="0.03 -0.01 -0.002" rpy="0 -0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="1" upper="-1" effort="0" velocity="30"/>
        <dynamics damping="1" stiffness="0" integral="0" friction="0" frictionLoss="0" armature="0"/>
    </joint>
    <joint name="base_to_right_back_wheel" type="continuous">
        <child link="right_back_wheel"/>
        <parent link="base_link"/>
        <origin xyz="-0.03 -0.01 -0.002" rpy="0 -0 0"/>
        <linkTransform xyz="-0.03 -0.01 -0.002" rpy="0 -0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="1" upper="-1" effort="0" velocity="30"/>
        <dynamics damping="1" stiffness="0" integral="0" friction="0" frictionLoss="0" armature="0"/>
    </joint>
</robot>
